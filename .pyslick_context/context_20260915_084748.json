       <line x1=\"80\" y1=\"120\" x2=\"120\" y2=\"120\" stroke=\"#bfb080\" stroke-width=\"1\"/>\n        <line x1=\"80\" y1=\"126\" x2=\"120\" y2=\"126\" stroke=\"#bfb080\" stroke-width=\"1\"/>\n      </g>\n\n      <!-- Bird body -->\n      <ellipse cx=\"80\" cy=\"75\" rx=\"30\" ry=\"26\" fill=\"#4a90d9\"/>\n      <!-- Bird belly -->\n      <ellipse cx=\"80\" cy=\"80\" rx=\"18\" ry=\"16\" fill=\"#eaf4ff\"/>\n      <!-- Wing (left, animated) -->\n      <g class=\"wing\" style=\"transform-box:fill-box;\">\n        <ellipse cx=\"58\" cy=\"75\" rx=\"18\" ry=\"12\" fill=\"#3a78c0\" transform=\"rotate(-10 58 75)\"/>\n      </g>\n      <!-- Wing tip lines -->\n      <line x1=\"48\" y1=\"72\" x2=\"42\" y2=\"78\" stroke=\"#2a5fa0\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      <line x1=\"50\" y1=\"76\" x2=\"44\" y2=\"82\" stroke=\"#2a5fa0\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      <!-- Right wing -->\n      <ellipse cx=\"102\" cy=\"75\" rx=\"18\" ry=\"12\" fill=\"#3a78c0\" transform=\"rotate(10 102 75)\"/>\n\n      <!-- Head -->\n      <ellipse cx=\"80\" cy=\"50\" rx=\"22\" ry=\"20\" fill=\"#4a90d9\"/>\n      <!-- Tuft -->\n      <ellipse cx=\"80\" cy=\"32\" rx=\"8\" ry=\"10\" fill=\"#3a78c0\" transform=\"rotate(-5 80 32)\"/>\n      <ellipse cx=\"72\" cy=\"33\" rx=\"5\" ry=\"8\" fill=\"#2a68a9\" transform=\"rotate(-20 72 33)\"/>\n\n      <!-- Eye white -->\n      <circle cx=\"74\" cy=\"48\" r=\"7\" fill=\"white\"/>\n      <!-- Eye -->\n      <circle cx=\"74\" cy=\"48\" r=\"4.5\" fill=\"#1a1a1a\"/>\n      <!-- Pupil highlight -->\n      <circle cx=\"75.5\" cy=\"46.5\" r=\"1.5\" fill=\"white\"/>\n      <!-- Sad eyebrow -->\n      <path d=\"M68 42 Q74 40 80 43\" stroke=\"#2a5fa0\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n\n      <!-- Beak -->\n      <path d=\"M62 54 L54 58 L62 60 Z\" fill=\"#f0b429\"/>\n      <!-- Mouth frown -->\n      <path d=\"M62 58 Q58 62 56 60\" stroke=\"#d09010\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/>\n\n      <!-- Feet on book -->\n      <line x1=\"72\" y1=\"100\" x2=\"68\" y2=\"105\" stroke=\"#f0b429\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      <line x1=\"80\" y1=\"100\" x2=\"80\" y2=\"105\" stroke=\"#f0b429\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      <line x1=\"88\" y1=\"100\" x2=\"92\" y2=\"105\" stroke=\"#f0b429\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      <!-- Toe nails -->\n      <line x1=\"68\" y1=\"105\" x2=\"64\" y2=\"105\" stroke=\"#f0b429\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <line x1=\"68\" y1=\"105\" x2=\"68\" y2=\"108\" stroke=\"#f0b429\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <line x1=\"80\" y1=\"105\" x2=\"76\" y2=\"105\" stroke=\"#f0b429\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <line x1=\"80\" y1=\"105\" x2=\"80\" y2=\"108\" stroke=\"#f0b429\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <line x1=\"92\" y1=\"105\" x2=\"96\" y2=\"105\" stroke=\"#f0b429\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <line x1=\"92\" y1=\"105\" x2=\"92\" y2=\"108\" stroke=\"#f0b429\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n  </div>\n\n  <div class=\"message\">No internet connection</div>\n  <div class=\"sub\">Check your connection and try again</div>\n  \n  <button onclick=\"handleReload()\">Retry</button>\n</div>\n\n<script>\n  function handleReload() {\n    if (window.median && window.median.webview && typeof window.median.webview.reload === 'function') {\n      window.median.webview.reload();\n    } else if (window.gonative && window.gonative.webview && typeof window.gonative.webview.reload === 'function') {\n      window.gonative.webview.reload();\n    } else {\n      window.location.reload();\n    }\n  }\n</script>\n</body>\n</html>",
