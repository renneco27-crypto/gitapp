      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" />\n<title>No Connection</title>\n<style>\n  :root {\n    --text-primary: #1c1c1e;\n    --text-secondary: #636366;\n    --border-strong: #c6c6c8;\n    --surface-1: #f2f2f7;\n    --accent: #2e75b6;\n  }\n\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --text-primary: #f2f2f7;\n      --text-secondary: #a1a1a6;\n      --border-strong: #38383a;\n      --surface-1: #2c2c2e;\n    }\n  }\n\n  * {\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  html, body {\n    margin: 0;\n    padding: 0;\n    width: 100%;\n    min-height: 100dvh;\n    background: transparent;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  body {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .container {\n    width: 100%;\n    max-width: 480px;\n    margin: 0 auto;\n    text-align: center;\n    padding: max(24px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) max(32px, env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left));\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* Fluid & enlarged bird wrapper */\n  .bird-wrap {\n    position: relative;\n    width: clamp(210px, 55vw, 290px);\n    aspect-ratio: 1 / 1;\n    margin: 0 auto;\n  }\n\n  .bird-wrap svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n    overflow: visible;\n  }\n\n  /* Tears locked to percentages so they stay aligned at any screen size */\n  .tear {\n    position: absolute;\n    width: 3.75%;\n    height: 6.25%;\n    border-radius: 50% 50% 60% 60%;\n    animation: fall 1.2s infinite;\n    opacity: 0;\n    pointer-events: none;\n  }\n  .tear1 {\n    background: #74b9ff;\n    left: 23.75%;\n    top: 38.75%;\n    animation-delay: 0s;\n  }\n  .tear2 {\n    background: #74b9ff;\n    left: 32.5%;\n    top: 36.25%;\n    animation-delay: 0.5s;\n  }\n\n  @keyframes fall {\n    0%   { opacity: 0; transform: translateY(0); }\n    20%  { opacity: 1; }\n    80%  { opacity: 1; }\n    100% { opacity: 0; transform: translateY(180%); }\n  }\n\n  /* Page flip */\n  .page {\n    transform-origin: left center;\n    animation: flip 0.9s infinite ease-in-out;\n  }\n  @keyframes flip {\n    0%   { transform: rotateY(0deg); opacity: 1; }\n    45%  { transform: rotateY(-80deg); opacity: 0.3; }\n    50%  { transform: rotateY(-80deg); opacity: 0.3; }\n    100% { transform: rotateY(0deg); opacity: 1; }\n  }\n\n  /* Wing flap */\n  .wing {\n    transform-origin: 80% 50%;\n    animation: flap 0.9s infinite ease-in-out;\n  }\n  @keyframes flap {\n    0%, 100% { transform: rotate(0deg); }\n    50%      { transform: rotate(-18deg); }\n  }\n\n  /* Scalable typography */\n  .message {\n    margin-top: clamp(20px, 4.5vw, 32px);\n    color: var(--text-primary);\n    font-size: clamp(1.25rem, 5vw, 1.65rem);\n    font-weight: 600;\n    letter-spacing: -0.015em;\n  }\n\n  .sub {\n    color: var(--text-secondary);\n    font-size: clamp(0.95rem, 3.8vw, 1.12rem);\n    margin-top: 8px;\n    max-width: 320px;\n    line-height: 1.45;\n  }\n\n  /* Touch-friendly, accessible button */\n  button {\n    margin-top: clamp(24px, 5vw, 36px);\n    min-height: 48px;\n    min-width: 150px;\n    padding: 12px 36px;\n    border: 1px solid var(--border-strong);\n    background: transparent;\n    border-radius: 12px;\n    font-size: clamp(1rem, 4vw, 1.15rem);\n    font-weight: 600;\n    color: var(--text-primary);\n    cursor: pointer;\n    transition: transform 0.15s ease, background 0.2s ease, opacity 0.2s ease;\n  }\n\n  button:hover {\n    background: var(--surface-1);\n  }\n\n  button:active {\n    transform: scale(0.96);\n    opacity: 0.8;\n  }\n</style>\n</head>\n<body>